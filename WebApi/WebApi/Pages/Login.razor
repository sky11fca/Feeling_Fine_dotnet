@page "/login"
@using WebApi.Models
@using WebApi.Models.Requests
@using WebApi.Services.Authentication
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IAuthenticationService AuthenticationService
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-16">Login</MudText>

    <div class="liquid-glass-card">
        <MudTextField @bind-Value="loginDto.Email" 
                      Label="Email" 
                      Underline="false"
                      Variant="Variant.Filled" 
                      Class="liquid-glass-input mb-6" 
                      InputType="InputType.Email" />

        <MudTextField @bind-Value="loginDto.Password" 
                      Label="Password" 
                      Underline="false"
                      Variant="Variant.Filled" 
                      Class="liquid-glass-input mb-16" 
                      InputType="InputType.Password" />

        <MudButton Variant="Variant.Filled" 
                   Class="liquid-glass-btn-primary full-width py-3" 
                   OnClick="LoginUser">
            Login
        </MudButton>
    </div>
</MudContainer>

@code {
    
    private LoginCommand loginDto = new LoginCommand();

    protected override async Task OnInitializedAsync()
    {
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/reviews");
        }
    }

    private async Task LoginUser()
    {
        var token = await AuthenticationService.Login(loginDto.Email, loginDto.Password);
        if (!string.IsNullOrEmpty(token))
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", token);
            
            var payload = token.Split('.')[1];
            var jsonBytes = ParseBase64WithoutPadding(payload);
            var keyValuePairs = JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
            
            if (keyValuePairs != null)
            {
                var businessId = keyValuePairs.TryGetValue("businessId", out var bIdObj) ? bIdObj.ToString() : Guid.Empty.ToString();
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "businessId", businessId);
                
                NavigationManager.NavigateTo("/reviews");
            }
        }
    }

    private byte[] ParseBase64WithoutPadding(string base64)
    {
        base64 = base64.Replace('-', '+').Replace('_', '/');
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return Convert.FromBase64String(base64);
    }
}
