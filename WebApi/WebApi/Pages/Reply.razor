@page "/review/{reviewId:guid}"
@using WebApi.Models
@using WebApi.Services.Reply
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using WebApi.Shared
@inject IReplyService ReplyService
@inject NavigationManager NavigationManager
@inject HttpClient http
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16">
    <Navbar/>
    
    <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-16">Reply to Review</MudText>

    <div class="liquid-glass-section">
        <MudText Typo="Typo.h2" Class="mb-6">Review Details</MudText>
        <div class="liquid-glass-card">
            <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">Review by @ClientName</MudText>
            <MudChip T="string" Size="Size.Small" Class="mb-4" Color="Color.Secondary">
                Sentiment: @Sentiment
            </MudChip>
            <MudText Typo="Typo.body1" Class="text-white">@RawText</MudText>
        </div>
    </div>

    <div class="liquid-glass-section">
        <MudText Typo="Typo.h2" Class="mb-6">Leave a Reply</MudText>
        <div class="liquid-glass-card">
            <EditForm Model="@_replyInput" OnValidSubmit="@SubmitReply">
                <DataAnnotationsValidator/>
                <ValidationSummary/>

                @if (_isGeneratingReply)
                {
                    <div class="d-flex flex-column align-center justify-center py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4"/>
                        <MudText Typo="Typo.body1" Color="Color.Primary">Generating AI reply...</MudText>
                    </div>
                }
                else
                {
                    <MudTextField @bind-Value="_replyInput.RawText"
                                  Label="Reply"
                                  Variant="Variant.Filled"
                                  Underline="false"
                                  Lines="6"
                                  Class="liquid-glass-input mb-6"/>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Class="liquid-glass-btn-primary full-width py-3">
                        Submit
                    </MudButton>
                }
            </EditForm>
        </div>
    </div>
</MudContainer>

@code {
    [Parameter]
    public Guid ReviewId { get; set; }

    [SupplyParameterFromQuery]
    public Guid ClientId { get; set; }

    [SupplyParameterFromQuery]
    public string RawText { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string ClientName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string Sentiment { get; set; } = string.Empty;

    private ReplyInput _replyInput = new();
    private bool _isGeneratingReply = true;

    protected async override Task OnInitializedAsync()
    {
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            _isGeneratingReply = true;
            var response = await http.PostAsJsonAsync("http://localhost:8000/ai/reply/", new {raw_text = RawText, customer_name = ClientName, sentiment = Sentiment});
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ReplyInput>();
                if (result != null)
                {
                    _replyInput.RawText = result.RawText;
                }
            }
        }
        catch
        {
            _replyInput.RawText = string.Empty;
        }
        finally
        {
            _isGeneratingReply = false;
        }
    }

    private async Task SubmitReply()
    {
        await ReplyService.AddReviewAsync(ReviewId, ClientId, _replyInput.RawText);
        NavigationManager.NavigateTo("/reviews");
    }

    public class ReplyInput
    {
        [JsonPropertyName("reply")]
        public string RawText { get; set; } = string.Empty;
    }

    public class GenerateReply
    {
        public string RawText { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string Sentiment { get; set; } = string.Empty;
    }
}
