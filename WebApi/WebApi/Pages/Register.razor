@page "/register"
@using WebApi.Models.Requests
@using WebApi.Services.Authentication
@using WebApi.Services.Business
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IBusinessService BusinessService
@inject IAuthenticationService AuthenticationService

<h3>Register</h3>

<div class="card">
    <div class="card-body">
        <div class="form-group">
            <label>Username</label>
            <input class="form-control" @bind="_registerDto.Username" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <input class="form-control" @bind="_registerDto.Email" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" class="form-control" @bind="_registerDto.Password" />
        </div>
        <div class="form-group">
            <label>Role</label>
            <input class="form-control" @bind="_registerDto.UserRole" />
        </div>
        <div class="form-group">
            <label>Business Name</label>
            <input class="form-control" @bind="_businessInput.Name" />
        </div>
        <div class="form-group">
            <label>Business Industry</label>
            <input class="form-control" @bind="_businessInput.Industry" />
        </div>
        <button class="btn btn-primary" @onclick="RegisterUser">Register</button>
    </div>
</div>

@code {
    private RegisterCommand _registerDto = new RegisterCommand();
    private BusinessInput _businessInput = new BusinessInput();

    private async Task RegisterUser()
    {
        var businessId = Guid.Empty;
        var queryResponse = await BusinessService.GetBusinessQuery(_businessInput.Name, _businessInput.Industry);
        if (queryResponse.Count == 0)
        {
            businessId = await BusinessService.AddBusiness(_businessInput.Name, _businessInput.Industry);
            await AuthenticationService.Register(new RegisterCommand
            {
                Email = _registerDto.Email,
                BusinessId = businessId,
                Password = _registerDto.Password,
                Username = _registerDto.Username,
                UserRole = _registerDto.UserRole
            });
            NavigationManager.NavigateTo("/login");
            return;
        }

        businessId = queryResponse[0].Id;
        await AuthenticationService.Register(new RegisterCommand
        {
            Email = _registerDto.Email,
            BusinessId = businessId,
            Password = _registerDto.Password,
            Username = _registerDto.Username,
            UserRole = _registerDto.UserRole
        });
        NavigationManager.NavigateTo("/login");
    }

    private class BusinessInput()
    {
        public string Name { get; set; }
        public string Industry { get; set; }
    }
}
