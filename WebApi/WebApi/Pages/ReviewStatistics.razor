@page "/review-statistics"
@using WebApi.Models
@using WebApi.Models.Responses
@using WebApi.Services.Client
@using WebApi.Services.Reviews
@using WebApi.Shared
@inject IReviewsService ReviewsService
@inject IClientService ClientService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <Navbar/>
    
    <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-8">AI Review Analytics</MudText>

    @if (_isProcessing)
    {
        <div class="d-flex flex-column align-center justify-center my-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-4">Ollama AI is analyzing your reviews...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-8">@_error</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadData">Retry</MudButton>
    }
    else if (_stats != null)
    {
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary" Class="mb-12">
            Insight generated by Gemma:2b based on @_totalReviews reviews
        </MudText>

        <MudGrid>
            @* Rating Chart *@
            <MudItem xs="12" md="4">
                <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="height: 450px;">
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">Rating Distribution</MudText>
                    <div style="height: 320px; width: 100%;">
                        <canvas id="ratingChart"></canvas>
                    </div>
                </MudPaper>
            </MudItem>

            @* Client Chart *@
            <MudItem xs="12" md="4">
                <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="height: 450px;">
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">Top Clients</MudText>
                    <div style="height: 320px; width: 100%;">
                        <canvas id="clientChart"></canvas>
                    </div>
                </MudPaper>
            </MudItem>

            @* Sentiment Chart *@
            <MudItem xs="12" md="4">
                <MudPaper Elevation="4" Class="pa-6 rounded-xl" Style="height: 450px;">
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">Sentiment Analysis</MudText>
                    <div style="height: 320px; width: 100%;">
                        <canvas id="sentimentChart"></canvas>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="d-flex justify-center mt-12 gap-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadData" StartIcon="@Icons.Material.Filled.Refresh">
                Recalculate with AI
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(async () => await ExportCsv(false))" StartIcon="@Icons.Material.Filled.Download">
                Export CSV (Summary)
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@(async () => await ExportCsv(true))" StartIcon="@Icons.Material.Filled.TableChart">
                Export CSV (Detailed)
            </MudButton>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="my-8">No reviews found to analyze.</MudAlert>
    }
</MudContainer>

@code {
    private bool _isProcessing = true;
    private string? _error;
    private AiStatisticsResponse? _stats;
    private int _totalReviews = 0;
    private List<ReviewDto?> _reviews = new();
    private Dictionary<string, string> _clientMap = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_stats != null && !_isProcessing)
        {
            // Initialize charts after Blazor has rendered the canvas elements
            await InvokeAsync(async () => {
                await JSRuntime.InvokeVoidAsync("renderPieChart", "ratingChart", _stats.Ratings.Labels, _stats.Ratings.Data);
                await JSRuntime.InvokeVoidAsync("renderPieChart", "sentimentChart", _stats.Sentiments.Labels, _stats.Sentiments.Data);
                await JSRuntime.InvokeVoidAsync("renderPieChart", "clientChart", _stats.Clients.Labels, _stats.Clients.Data);
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isProcessing = true;
        _error = null;
        _stats = null;
        _reviews = new();
        _clientMap = new();
        StateHasChanged();

        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var claims = ParseClaimsFromJwt(token).ToList();
            
            // Log claims for debugging if needed (Console.WriteLine)
            var roleClaim = claims.FirstOrDefault(c => c.Type == "role" || 
                                                       c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;
            
            var isAdmin = roleClaim?.Equals("Admin", StringComparison.OrdinalIgnoreCase) ?? false;

            var businessIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "businessId");
            Guid businessId = Guid.Empty;

            if (!isAdmin)
            {
                // Try to get from localStorage first
                if (!string.IsNullOrWhiteSpace(businessIdStr))
                {
                    Guid.TryParse(businessIdStr.Trim('"', '\''), out businessId);
                }
                
                // If not in localStorage, MUST get from JWT 'jti' claim
                if (businessId == Guid.Empty)
                {
                    var jtiClaim = claims.FirstOrDefault(c => c.Type == "jti")?.Value;
                    if (!string.IsNullOrEmpty(jtiClaim))
                    {
                        Guid.TryParse(jtiClaim, out businessId);
                    }
                }
                
                // If STILL empty and not admin, we should probably not show anything or show an error
                if (businessId == Guid.Empty)
                {
                    _error = "Unable to determine your business association. Please contact support.";
                    _isProcessing = false;
                    return;
                }
            }

            var reviews = await ReviewsService.GetReviewQuery(businessId, string.Empty, string.Empty);
            if (reviews == null || !reviews.Any())
            {
                _isProcessing = false;
                return;
            }

            _reviews = reviews;
            _totalReviews = _reviews.Count;

            // Fetch Client Names for Mapping
            var clientIds = _reviews.Where(r => r != null).Select(r => r!.ClientId).Distinct();
            foreach (var id in clientIds)
            {
                try
                {
                    var client = await ClientService.FindAsync(id);
                    if (client != null) _clientMap[id.ToString().ToLower()] = client.Username;
                }
                catch { }
            }

            var aiResponse = await ReviewsService.GetAiStatistics(_reviews);
            if (aiResponse != null)
            {
                _stats = aiResponse;
                
                // Map client labels in the object itself before rendering
                _stats.Clients.Labels = _stats.Clients.Labels.Select(label => {
                    var match = _clientMap.Keys.FirstOrDefault(k => k.Contains(label.ToLower()));
                    return !string.IsNullOrEmpty(match) ? _clientMap[match] : label;
                }).ToArray();
            }
            else
            {
                _error = "AI service failed to generate statistics.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Critical error: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ExportCsv(bool detailed)
    {
        var validReviews = _reviews.Where(r => r != null).Cast<ReviewDto>().ToList();
        var sb = new System.Text.StringBuilder();
        
        if (detailed)
        {
            sb.AppendLine("Id,ClientId,ClientName,Rating,RatingType,SentimentLabel,SentimentAccuracy,SubmittedOn,Text");
            foreach (var r in validReviews)
            {
                var cName = _clientMap.TryGetValue(r.ClientId.ToString().ToLower(), out var name) ? name : "Unknown";
                var text = r.RawText.Replace("\"", "\"\"");
                sb.AppendLine($"{r.Id},{r.ClientId},{cName},{r.Review},{r.RatingType},{r.SentimentLabel},{r.SentimentAccuracy},{r.SubmittedOn},\"{text}\"");
            }
        }
        else
        {
            sb.AppendLine("Rating,Sentiment,ClientName,SubmittedOn");
            foreach (var r in validReviews)
            {
                var cName = _clientMap.TryGetValue(r.ClientId.ToString().ToLower(), out var name) ? name : "Unknown";
                sb.AppendLine($"{r.Review},{r.SentimentLabel},{cName},{r.SubmittedOn}");
            }
        }

        var csvContent = sb.ToString();
        var fileName = detailed ? "ai_reviews_detailed.csv" : "ai_reviews_summary.csv";
        var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
        var base64 = Convert.ToBase64String(bytes);

        var script = $@"
            var bstr = atob('{base64}');
            var n = bstr.length;
            var u8arr = new Uint8Array(n);
            while(n--) {{
                u8arr[n] = bstr.charCodeAt(n);
            }}
            var blob = new Blob([u8arr], {{type: 'text/csv'}});
            var url = window.URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        ";

        await JSRuntime.InvokeVoidAsync("eval", script);
    }

    private IEnumerable<System.Security.Claims.Claim> ParseClaimsFromJwt(string jwt)
    {
        var claims = new List<System.Security.Claims.Claim>();
        var parts = jwt.Split('.');
        if (parts.Length < 2) return claims;
        
        var payload = parts[1];
        payload = payload.Replace('-', '+').Replace('_', '/');
        switch (payload.Length % 4)
        {
            case 2: payload += "=="; break;
            case 3: payload += "="; break;
        }
        var jsonBytes = Convert.FromBase64String(payload);
        var keyValuePairs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
        if (keyValuePairs != null) foreach (var kvp in keyValuePairs) claims.Add(new System.Security.Claims.Claim(kvp.Key, kvp.Value?.ToString() ?? string.Empty));
        return claims;
    }
}
