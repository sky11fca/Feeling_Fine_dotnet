@page "/reviews/{businessId:guid}"
@using WebApi.Models
@using WebApi.Services.Business
@using WebApi.Services.Client
@using WebApi.Services.Reviews
@using WebApi.Services.Reply
@using WebApi.Shared
@inject IReviewsService ReviewsService
@inject IBusinessService BusinessService
@inject IClientService ClientService
@inject IReplyService ReplyService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    
    <Navbar/>
    @if (_business != null)
    {
        <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-4">Reviews for @_business.Name</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-16 mud-text-secondary">@_business.Industry</MudText>
    }
    else
    {
        <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-16">Reviews</MudText>
    }

    <div class="liquid-glass-section">
        <MudText Typo="Typo.h2" Class="mb-6">Add a Review</MudText>
        <div class="liquid-glass-card">
            <EditForm Model="@_reviewInput" OnValidSubmit="@SubmitReview">
                <DataAnnotationsValidator/>
                <ValidationSummary/>

                <MudSelect T="Guid" @bind-Value="_reviewInput.BusinessId"
                           Label="Select Business"
                           Underline="false"
                           Variant="Variant.Filled"
                           Class="liquid-glass-input mb-6"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var b in _allBusinesses)
                    {
                        <MudSelectItem T="Guid" Value="@b.Id">@b.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid" @bind-Value="_reviewInput.ClientId"
                           Label="Select Client"
                           Underline="false"
                           Variant="Variant.Filled"
                           Class="liquid-glass-input mb-6"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var c in _allClients)
                    {
                        <MudSelectItem T="Guid" Value="@c.Id">@c.Username</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField @bind-Value="_reviewInput.Rating"
                                 Label="Rating (1-5)"
                                 Underline="false"
                                 Min="1" Max="5"
                                 Variant="Variant.Filled"
                                 Class="liquid-glass-input mb-6"/>

                <MudTextField @bind-Value="_reviewInput.RawText"
                              Label="Review"
                              Underline="false"
                              Variant="Variant.Filled"
                              Lines="4"
                              Class="liquid-glass-input mb-6"/>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Class="liquid-glass-btn-primary full-width py-3">
                    Submit
                </MudButton>
            </EditForm>
        </div>
    </div>

    @if (_reviewList.Count != 0)
    {
        <div class="liquid-glass-section">
            <MudText Typo="Typo.h2" Class="mb-6">All Reviews</MudText>
            <MudStack Spacing="6">
                @foreach (var review in _reviewList)
                {
                    <a href="/review/@review.Id?businessId=@BusinessId&clientId=@review.ClientId&rawText=@Uri.EscapeDataString(review.RawText)&clientName=@Uri.EscapeDataString(_clientNames.TryGetValue(review.ClientId, out var name) ? name : "Unknown")&sentiment=@Uri.EscapeDataString(review.SentimentLabel)" style="text-decoration: none;">
                        <div class="liquid-glass-card">
                            <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">
                                <strong>@(_clientNames.TryGetValue(review.ClientId, out var username) ? username : review.Id.ToString())</strong>
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Class="mb-2" Color="Color.Secondary">
                                Rating: @review.Review / 5.0 (@review.RatingType)
                            </MudChip>
                            <MudText Typo="Typo.body1" Class="mb-4 text-white">@review.RawText</MudText>

                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Posted on: @review.SubmittedOn</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Sentiment: @review.SentimentLabel (Accuracy: @review.SentimentAccuracy)</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (_replies.TryGetValue(review.Id, out var reply))
                            {
                                <div class="mt-4 p-4 liquid-glass-floating">
                                    <MudText Typo="Typo.body2" Class="text-white"><strong>Reply:</strong> @reply.RawText</MudText>
                                </div>
                            }
                        </div>
                    </a>
                }
            </MudStack>
        </div>
    }
    else
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary">No reviews found</MudText>
    }
</MudContainer>

@code {

    [Parameter]
    public Guid BusinessId { get; set; }

    private List<ReviewDto?> _reviewList = new();
    private BusinessDto? _business;
    private List<BusinessDto> _allBusinesses = new();
    private List<ClientDto> _allClients = new();
    private ReviewInput _reviewInput = new();
    private Dictionary<Guid, string> _clientNames = new();
    private Dictionary<Guid, ReplyDto> _replies = new();
    private bool _isAdmin = false;

    protected async override Task OnInitializedAsync()
    {
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            _reviewList = await ReviewsService.GetReviewQuery(Guid.Empty, string.Empty, string.Empty);
            await FetchClientNames();
            await FetchReplies();
            _allBusinesses = await BusinessService.GetBusinessQuery(string.Empty, string.Empty);
            _business = _allBusinesses.Find(b => b.Id == BusinessId);
            
            // Assumed method to fetch all clients; adjust to match your IClientService signature
            _allClients = await ClientService.Query();
            _reviewInput.BusinessId = BusinessId;
        }
        catch
        {
            _reviewList = new();
        }
    }

    private async Task FetchClientNames()
    {
        foreach (var review in _reviewList)
        {
            if (review != null && !_clientNames.ContainsKey(review.ClientId))
            {
                try
                {
                    var client = await ClientService.FindAsync(review.ClientId);
                    if (client != null)
                    {
                        _clientNames[review.ClientId] = client.Username;
                    }
                }
                catch { }
            }
        }
    }

    private async Task FetchReplies()
    {
        foreach (var review in _reviewList)
        {
            if (review != null && !_replies.ContainsKey(review.Id))
            {
                try
                {
                    var replies = await ReplyService.GetRepliesAsync(review.Id);
                    if (replies != null && replies.Count > 0)
                    {
                        _replies[review.Id] = replies[0];
                    }
                }
                catch { }
            }
        }
    }

    private async Task SubmitReview()
    {
        await ReviewsService.AddReview(_reviewInput.BusinessId, _reviewInput.ClientId, _reviewInput.Rating, _reviewInput.RawText,"FeelingFine.net");
        
        _reviewList = await ReviewsService.GetReviewQuery(Guid.Empty, string.Empty, string.Empty);
        await FetchClientNames();
        await FetchReplies();
        _reviewInput = new ReviewInput { BusinessId = BusinessId };
    }

    public class ReviewInput
    {
        public Guid BusinessId { get; set; }
        public Guid ClientId { get; set; }
        public decimal Rating { get; set; }
        public string RawText { get; set; } = string.Empty;
    }

    private byte[] ParseBase64WithoutPadding(string base64)
    {
        base64 = base64.Replace('-', '+').Replace('_', '/');
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return Convert.FromBase64String(base64);
    }
}
